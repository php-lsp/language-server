{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start LSP Server",
            "type": "shell",
            "command": "php",
            "args": [
                "./bin/lsp",
                "serve",
                "App\\Application",
                "--port=5007"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "echo": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
