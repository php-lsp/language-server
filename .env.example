###> symfony/framework ###
APP_ENV=prod
APP_SECRET=
###< symfony/framework ###

###> app/logger ###
# Logger name displayed in log entries
APP_LOGGER_NAME=php-lsp
###< app/logger ###

###> app/buggregator ###
# Buggregator trap server connection (host:port)
# Used for structured JSON log forwarding via TCP socket
BUGGREGATOR_HOST=127.0.0.1:9913
###< app/buggregator ###

###> app/telemetry ###
# OTLP HTTP endpoint for APM trace export
# Leave empty to disable APM (uses NoopTracer with zero overhead)
# Examples:
#   SigNoz:  http://localhost:4318
#   Jaeger:  http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name displayed in the APM dashboard
OTEL_SERVICE_NAME=php-lsp
###< app/telemetry ###
