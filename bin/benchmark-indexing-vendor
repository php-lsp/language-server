#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Benchmark: Sequential vs Parallel indexing on vendor/ (large file set).
 */

require __DIR__ . '/../vendor/autoload.php';

use Amp\Future;
use Amp\Parallel\Worker\ContextWorkerPool;
use App\Module\Parallel\Task\FileIndexTask;
use App\Module\Parallel\Task\WarmupTask;
use PhpParser\ErrorHandler\Collecting;
use PhpParser\NodeTraverser;
use PhpParser\NodeVisitor\NameResolver;
use PhpParser\NodeVisitor\NodeConnectingVisitor;
use PhpParser\NodeVisitor\ParentConnectingVisitor;
use PhpParser\ParserFactory;

$workerCount = (int)($argv[1] ?? 4);
$maxFiles = (int)($argv[2] ?? 500);

function collectPhpFiles(string $dir, int &$count, int $max): array
{
    $files = [];
    $items = @scandir($dir);
    if ($items === false) {
        return [];
    }
    foreach ($items as $item) {
        if ($count >= $max) {
            return $files;
        }
        if ($item === '.' || $item === '..') {
            continue;
        }
        $path = $dir . '/' . $item;
        if (is_dir($path)) {
            $files = array_merge($files, collectPhpFiles($path, $count, $max));
        } elseif (str_ends_with($item, '.php')) {
            $files[] = $path;
            $count++;
        }
    }
    return $files;
}

$count = 0;
$phpFiles = collectPhpFiles(__DIR__ . '/../vendor', $count, $maxFiles);

$fileData = [];
$totalBytes = 0;
foreach ($phpFiles as $path) {
    $content = @file_get_contents($path);
    if ($content !== false && strlen($content) > 0) {
        $fileData[] = ['uri' => 'file://' . $path, 'content' => $content];
        $totalBytes += strlen($content);
    }
}

echo "╔══════════════════════════════════════════════════════════════╗\n";
echo "║          Vendor Indexing Parallel Benchmark                 ║\n";
echo "╠══════════════════════════════════════════════════════════════╣\n";
echo "║  PHP files:        " . str_pad((string)count($fileData), 39) . "║\n";
echo "║  Total size:       " . str_pad(number_format($totalBytes / 1024, 1) . ' KB', 39) . "║\n";
echo "║  Worker pool size: " . str_pad((string)$workerCount, 39) . "║\n";
echo "╚══════════════════════════════════════════════════════════════╝\n\n";

function benchmark(string $name, callable $fn): array
{
    $fn(); // warmup

    $start = hrtime(true);
    $result = $fn();
    $elapsed = (hrtime(true) - $start) / 1_000_000;

    echo sprintf("  %-38s %8.2f ms  entries: %d\n", $name, $elapsed, $result);
    return ['time' => $elapsed, 'entries' => $result];
}

// Sequential
echo "── Sequential ──\n";
$seq = benchmark('Sequential (single-thread)', function () use ($fileData) {
    $parser = (new ParserFactory())->createForNewestSupportedVersion();
    $totalEntries = 0;

    foreach ($fileData as $file) {
        $errorHandler = new Collecting();
        try {
            $ast = $parser->parse($file['content'], $errorHandler);
            if ($ast === null) {
                continue;
            }
            $traverser = new NodeTraverser(
                new NameResolver($errorHandler, ['preserveOriginalNames' => true]),
                new NodeConnectingVisitor(),
                new ParentConnectingVisitor(),
            );
            $ast = $traverser->traverse($ast);

            foreach ($ast as $node) {
                if ($node instanceof \PhpParser\Node\Stmt\Namespace_) {
                    foreach ($node->stmts as $stmt) {
                        if (
                            $stmt instanceof \PhpParser\Node\Stmt\Class_
                            || $stmt instanceof \PhpParser\Node\Stmt\Interface_
                            || $stmt instanceof \PhpParser\Node\Stmt\Trait_
                            || $stmt instanceof \PhpParser\Node\Stmt\Function_
                        ) {
                            $totalEntries++;
                        }
                    }
                }
            }
        } catch (\Throwable) {
            // skip
        }
    }

    return $totalEntries;
});

// Parallel
echo "\n── AMPHP parallel ──\n";
$pool = new ContextWorkerPool($workerCount);
$warmup = [];
for ($i = 0; $i < $workerCount; $i++) {
    $warmup[] = $pool->submit(new WarmupTask())->getFuture();
}
Future\await($warmup);
echo "  Workers ready.\n";

$par = benchmark('AMPHP parallel (workers)', function () use ($fileData, $pool) {
    $totalEntries = 0;
    $batches = array_chunk($fileData, 20);

    foreach ($batches as $batch) {
        $futures = [];
        foreach ($batch as $file) {
            $futures[] = $pool->submit(new FileIndexTask($file['uri'], $file['content']))->getFuture();
        }
        $results = Future\await($futures);
        foreach ($results as $indexData) {
            foreach ($indexData as $entries) {
                $totalEntries += count($entries);
            }
        }
    }

    return $totalEntries;
});

$pool->shutdown();

// Summary
$speedup = $seq['time'] / $par['time'];
echo sprintf(
    "\n=> Speedup: %.2fx %s\n",
    $speedup,
    $speedup > 1.1 ? 'FASTER' : ($speedup < 0.9 ? 'SLOWER' : 'SAME'),
);
echo sprintf(
    "=> Files/sec: Sequential=%.0f  Parallel=%.0f\n",
    count($fileData) / ($seq['time'] / 1000),
    count($fileData) / ($par['time'] / 1000),
);
