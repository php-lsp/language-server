{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "php-lsp/skeleton",
    "type": "project",
    "license": "MIT",
    "description": "The skeleton application for the Language Server Protocol extension",
    "support": {
        "issues": "https://github.com/php-lsp/skeleton/issues",
        "source": "https://github.com/php-lsp/skeleton"
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru",
            "homepage": "https://nesk.me"
        }
    ],
    "require": {
        "php": "^8.4",
        "monolog/monolog": "^3.8",
        "nikic/php-parser": "^5.6",
        "php-lsp/bridge-hydrator-type-lang": "^1.0",
        "php-lsp/bridge-server-react": "^1.0",
        "php-lsp/ext-document-manager": "^1.0",
        "php-lsp/kernel": "^1.0",
        "php-lsp/protocol": "^1.0",
        "php-lsp/workspace": "^1.0",
        "phpstan/phpstan": "^2.1",
        "react/async": "^4.3",
        "react/filesystem": "0.2.x-dev",
        "react/http": "^1.11",
        "react/promise-timer": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app"
        }
    },
    "require-dev": {
        "buggregator/trap": "^1.13",
        "carthage-software/mago": "^1.14",
        "php-lsp/protocol-generator": "^1.0",
        "phpunit/phpunit": "^10.5|^11.5",
        "symfony/var-dumper": "^6.4|^7.0"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "scripts-aliases": {
        "mago:lint": ["lint", "linter", "mago-lint"],
        "mago:analyze": ["analyze", "mago-analyze"],
        "mago:fix": ["fix", "mago-fix"],
        "mago:baseline": ["baseline", "mago-baseline"],
        "mago:format": ["format", "fmt", "cs", "codestyle"],
        "test:unit": ["phpunit", "unit"],
        "test:e2e": ["e2e", "playground"],
        "build:prod": ["build"],
        "build:run": ["run"]
    },
    "scripts-descriptions": {
        "test": "Runs all tests",
        "test:unit": "Runs unit tests only",
        "test:e2e": "Runs E2E playground tests (starts real LSP server)",
        "mago:lint": "Runs Mago linter with baseline",
        "mago:analyze": "Runs Mago analyzer with baseline",
        "mago:fix": "Applies Mago auto-fixes to source code",
        "mago:baseline": "Regenerates Mago baselines for lint and analysis",
        "mago:format": "Formats source code with Mago formatter",
        "mago:format:check": "Checks source code formatting (dry-run)",
        "build:prod": "Compiles PHAR and binary assembly of the LSP Server",
        "build:run": "Runs the compiled assembly",
        "build:run:local": "Runs the compiled PHAR (using local interpreter)",
        "build:prepare": "Prepare local environment for binary compilation"
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --testdox",
        "test:e2e": "phpunit --testdox --testsuite playground",
        "mago:lint": "mago lint --baseline mago-lint-baseline.toml",
        "mago:analyze": "mago analyze --baseline mago-analysis-baseline.toml",
        "mago:fix": "mago lint --fix --potentially-unsafe --format-after-fix",
        "mago:baseline": [
            "mago lint --generate-baseline --baseline mago-lint-baseline.toml",
            "mago analyze --generate-baseline --baseline mago-analysis-baseline.toml"
        ],
        "mago:format": "mago format",
        "mago:format:check": "mago format --check",
        "build:prod": "./bin/build",
        "build:prepare": [
            "Composer\\Config::disableProcessTimeout",
            "./bin/prepare"
        ],
        "build:run:local": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./var/prod/build.phar serve App\\\\Application --port=5007"
        ],
        "build:run": [
            "Composer\\Config::disableProcessTimeout",
            "./var/prod/build serve App\\\\Application --port=5007"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev",
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
